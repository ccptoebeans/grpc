        "VCPKG_TARGET_TRIPLET": "universal-osx-internal",
        "VCPKG_HOST_TRIPLET": "universal-osx-internal",
        "CMAKE_OSX_ARCHITECTURES": "arm64;x86_64",
        "VCPKG_CHAINLOAD_TOOLCHAIN_FILE": "${sourceDir}/cmake/toolchains/universal-carbon-osx.cmake"
      }
    },
